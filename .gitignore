# Harness-local installs (onboarding writes these per machine, like ~/.pi) —
# the payload under skills/meta/setup-tna/ is the distributable copy.
.pi/
.omp/
.dsh/
# Path-coercion artifacts: a hook that receives a non-string cwd used to build
# a literal '[object Object]' directory (audit-run-blockers #14). The bug is fixed
# in logVeto; this pattern keeps a future regression from hiding in git.
\[object Object\]/
\[object Object\]
