#!/bin/sh
# trust-no-agent pre-commit hook — structural + invocation-axis + ticket-graph validation before every commit.
# Active via: git config core.hooksPath scripts/hooks
root="$(git rev-parse --show-toplevel)"
"$root/scripts/validate.mjs" 2>/dev/null || node "$root/scripts/validate.mjs" || exit 1
"$root/scripts/eval.mjs" 2>/dev/null || node "$root/scripts/eval.mjs" || exit 1
"$root/scripts/tickets.test.mjs" 2>/dev/null || node "$root/scripts/tickets.test.mjs" || exit 1
"$root/scripts/doctor.test.mjs" 2>/dev/null || node "$root/scripts/doctor.test.mjs" || exit 1
"$root/scripts/ledger-audit.test.mjs" 2>/dev/null || node "$root/scripts/ledger-audit.test.mjs" || exit 1
"$root/scripts/reinject.test.mjs" 2>/dev/null || node "$root/scripts/reinject.test.mjs" || exit 1
"$root/scripts/behavioral-eval.test.mjs" 2>/dev/null || node "$root/scripts/behavioral-eval.test.mjs" || exit 1
"$root/scripts/behavioral-eval.mjs" 2>/dev/null || node "$root/scripts/behavioral-eval.mjs" || exit 1
# The two mechanical-layer guards: the hook entry point (fail-open contract) and
# the plugin mirror (byte-identical drift guard). Both run here because a drift
# in either ships silently — see each test's header.
"$root/scripts/gate-hook.test.mjs" 2>/dev/null || node "$root/scripts/gate-hook.test.mjs" || exit 1
"$root/scripts/plugin.test.mjs" 2>/dev/null || node "$root/scripts/plugin.test.mjs" || exit 1
"$root/scripts/codex-plugin.test.mjs" 2>/dev/null || node "$root/scripts/codex-plugin.test.mjs" || exit 1
"$root/scripts/changelog-guard.test.mjs" 2>/dev/null || node "$root/scripts/changelog-guard.test.mjs" || exit 1
# The workflow guard: a duplicated `run:` key in ci.yml is invalid YAML, and
# GitHub then never BUILDS the job (every run fails at 0s with "workflow file
# issue", logs not found) while every local gate stays green. That is exactly how
# CI went dark for v0.1.25 and v0.1.26 — this hook is where it becomes visible.
"$root/scripts/ci-guard.test.mjs" 2>/dev/null || node "$root/scripts/ci-guard.test.mjs" || exit 1
"$root/scripts/ci-guard.mjs" 2>/dev/null || node "$root/scripts/ci-guard.mjs" || exit 1
# The file budget RATCHET: every over-budget file this repo already carries is
# pinned in .filebudget-baseline.json at its measured size, so a change may
# shrink one but never grow one, and a NEW offender is refused outright. Wired
# here because it was opt-in and unwired until 2026-11-03 — the repo grew 80
# offenders while every local gate stayed green (docs/compatibility.md known
# limit 4). The pin file is the reviewed record; re-pinning is a separate commit.
"$root/scripts/file-budget.mjs" 2>/dev/null || node "$root/scripts/file-budget.mjs" || exit 1